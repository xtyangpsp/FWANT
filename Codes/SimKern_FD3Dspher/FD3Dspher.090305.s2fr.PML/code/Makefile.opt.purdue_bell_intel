#============================================================
# Makefile options for purdue_bell_intel (Intel MPI only)
#============================================================

FC      = mpiifort
CC      = mpiicc

# NetCDF (Intel builds)
NETCDF_FORTRAN_INC = /apps/spack/bell/apps/netcdf-fortran/4.5.3-intel-19.0.5-75zjiqj/include
NETCDF_FORTRAN_LIB = /apps/spack/bell/apps/netcdf-fortran/4.5.3-intel-19.0.5-75zjiqj/lib
NETCDF_C_LIB       = /apps/spack/bell/apps/netcdf/4.7.4-intel-19.0.5-ayoptmy/lib

# Compile flags (note: -c restored here)
FFLAGS  = -O3 -ftz -align records -no-prec-div -unroll1 -D_GNU_SOURCE \
          -module ./OBJ_$(CLUSTER) -I$(NETCDF_FORTRAN_INC) -c -zero
CFLAGS  = -O3

# Link flags: Intel MPI wrappers add MPI libs; add only NetCDF
LDFLAGS = -L$(NETCDF_FORTRAN_LIB) -lnetcdff \
          -L$(NETCDF_C_LIB)       -lnetcdf

