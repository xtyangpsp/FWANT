FC     := /apps/spack/bell-20250305/apps/openmpi/5.0.5-gcc-14.2.0-26e4elz/bin/mpif90
NETCDF := /apps/spack/bell-20250305/apps/netcdf-fortran/4.6.1-gcc-14.2.0-v3ecdga
MPILIB := /apps/spack/bell-20250305/apps/openmpi/5.0.5-gcc-14.2.0-26e4elz/lib

LDFLAGS := -L$(MPILIB) -lnetcdff \
        -L$(NETCDF)/lib -lnetcdff $(if $(STATIC),-Bstatic -static,)

FFLAGS := -D_GNU_SOURCE -c -zero -I$(NETCDF)/include \
         $(if $(WithOMP),-openmp -openmp_report2,)
FFLAGSMP := -mp1 -unroll0 -ip-no-inlining $(FFLAGS)

FFLAGS   := -O3  -unroll1 -Wl,-rpath -Wl,LIBDIR -D_GNU_SOURCE $(FFLAGS)
FFLAGSMP := -O3 $(FFLAGSMP)
LDFLAGS  := $(LDFLAGS)

